<?xml version="1.0" encoding="utf-8"?>
<!-- activity_result.xml -->
<!-- Halaman Hasil Pendaftaran | Tema Perkapalan -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/antique_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ===== HEADER SUKSES ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/navy_blue">

            <!-- Lingkaran Centang -->
            <LinearLayout
                android:id="@+id/layoutSuccessIcon"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:background="@drawable/bg_circle_gold_border"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/gold_amber"
                    android:contentDescription="Berhasil"/>
            </LinearLayout>

            <!-- Teks Berhasil -->
            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/layoutSuccessIcon"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp"
                android:text="Pendaftaran Berhasil!"
                android:textColor="#E8C87A"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvSuccessTitle"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="4dp"
                android:text="Data Anda telah tercatat di manifes kapal"
                android:textColor="#556080"
                android:textSize="12sp"
                android:textStyle="italic"/>

            <!-- Wave Bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_alignParentBottom="true"
                android:background="@color/antique_cream"/>
        </RelativeLayout>

        <!-- ===== KONTEN HASIL ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Badge No. Pendaftaran -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#F5EDCC"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/gold_amber"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NO. PENDAFTARAN"
                            android:textColor="#7A6030"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"/>

                        <TextView
                            android:id="@+id/tvNoPendaftaran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#SEM-2024-0001"
                            android:textColor="@color/navy_blue"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_receipt"
                        app:tint="@color/gold_amber"
                        android:contentDescription="Nomor"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Label: Data Pribadi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATA PRIBADI"
                android:textColor="@color/navy_blue"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="6dp"
                app:drawableTint="@color/navy_blue"/>

            <!-- Card: Data Pribadi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:strokeColor="#141B2A4A"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Row: Nama -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="12dp"
                            app:cardBackgroundColor="#F0EDE6"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_person"
                                app:tint="@color/navy_blue"
                                android:padding="7dp"
                                android:contentDescription="Nama"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="NAMA LENGKAP"
                                android:textColor="#8A9BBF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.04"/>
                            <TextView
                                android:id="@+id/tvNama"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="-"
                                android:textColor="@color/navy_blue" android:textSize="14sp" android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#F0EDE6"/>

                    <!-- Row: Email -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp" android:layout_height="32dp"
                            android:layout_marginEnd="12dp"
                            app:cardBackgroundColor="#F0EDE6" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:src="@drawable/ic_email" app:tint="@color/navy_blue"
                                android:padding="7dp" android:contentDescription="Email"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="EMAIL"
                                android:textColor="#8A9BBF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.04"/>
                            <TextView
                                android:id="@+id/tvEmail"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="-"
                                android:textColor="@color/navy_blue" android:textSize="14sp" android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#F0EDE6"/>

                    <!-- Row: Nomor HP -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp" android:layout_height="32dp"
                            android:layout_marginEnd="12dp"
                            app:cardBackgroundColor="#F0EDE6" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:src="@drawable/ic_phone" app:tint="@color/navy_blue"
                                android:padding="7dp" android:contentDescription="HP"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="NOMOR HP"
                                android:textColor="#8A9BBF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.04"/>
                            <TextView
                                android:id="@+id/tvHp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="-"
                                android:textColor="@color/navy_blue" android:textSize="14sp" android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#F0EDE6"/>

                    <!-- Row: Jenis Kelamin -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp" android:layout_height="32dp"
                            android:layout_marginEnd="12dp"
                            app:cardBackgroundColor="#F0EDE6" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                                android:src="@drawable/ic_gender" app:tint="@color/navy_blue"
                                android:padding="7dp" android:contentDescription="Gender"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="JENIS KELAMIN"
                                android:textColor="#8A9BBF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.04"/>
                            <TextView
                                android:id="@+id/tvGender"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="-"
                                android:textColor="@color/navy_blue" android:textSize="14sp" android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rope Divider -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:layout_marginBottom="12dp">
                <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1"
                    android:background="@drawable/bg_rope_line"/>
                <ImageView android:layout_width="12dp" android:layout_height="12dp"
                    android:src="@drawable/ic_anchor" android:layout_marginHorizontal="8dp"
                    app:tint="@color/gold_amber"/>
                <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1"
                    android:background="@drawable/bg_rope_line"/>
            </LinearLayout>

            <!-- Label: Seminar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEMINAR DIPILIH"
                android:textColor="@color/navy_blue"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <!-- Card: Seminar (Navy) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/navy_blue"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/gold_amber"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SEMINAR TERDAFTAR"
                        android:textColor="#80C9A84C"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvSeminar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#E8C87A"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:lineSpacingExtra="4dp"/>

                    <!-- Tag Konfirmasi -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="#1AC9A84C"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#4DC9A84C"
                        app:strokeWidth="1dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  ⚓  Sesi 2024 · Slot Terkonfirmasi  "
                            android:textColor="#A6C9A84C"
                            android:textSize="11sp"
                            android:textStyle="italic"
                            android:paddingVertical="5dp"/>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tombol Kembali ke Halaman Utama -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackHome"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="KEMBALI KE HALAMAN UTAMA"
                android:textColor="#E8C87A"
                android:textSize="12sp"
                android:letterSpacing="0.07"
                android:fontFamily="serif"
                android:textStyle="bold"
                app:backgroundTint="@color/navy_blue"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_home"
                app:iconTint="@color/gold_amber"
                app:iconGravity="textStart"
                app:rippleColor="@color/gold_amber"/>

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚓  Seminar Registration App — Navigator v1.0"
                android:textColor="#BCAE95"
                android:textSize="11sp"
                android:textStyle="italic"
                android:gravity="center"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>